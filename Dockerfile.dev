# Development image: Vite (5173) and FastAPI with reload, from a bind-mounted checkout.
FROM node:22-bookworm-slim AS dev
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/uv
WORKDIR /app
# Keep the Python environment out of the bind mount so it doesn't clash with the host's.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
# Toolchain for better-sqlite3, which the legacy server code's Vitest tests still use.
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
COPY backend/pyproject.toml backend/uv.lock backend/README.md ./backend/
RUN uv sync --project backend --locked --no-install-project
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
